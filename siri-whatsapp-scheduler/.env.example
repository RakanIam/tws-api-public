# WhatsApp Business Cloud API credentials
# Get these from https://developers.facebook.com/ -> Your App -> WhatsApp -> API Setup
WHATSAPP_API_TOKEN=your_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# API key to authenticate Siri Shortcut requests (generate a random string)
API_KEY=your_random_api_key_here

# Server configuration
HOST=0.0.0.0
PORT=5050

# Timezone for scheduling (IANA format)
TIMEZONE=Asia/Riyadh
